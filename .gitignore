/work
/container_icons

# Staging dirs left behind by an interrupted build.py run
.icon-build-*/
__pycache__/
*.pyc

# Server data is local, except the review database, which is shared so
# approve/reject/pending status follows the repo to other machines.
/icon_set/data/*
!/icon_set/data/feedback.sqlite3
/icons-json
/head

# Validation evidence: qa_overlays.py debug PNGs/metrics and the gallery's
# on-demand evidence cache. Regenerated from the SVG; never commit it.
/icon_set/data/qa-evidence/
*_distance_debug.png
*_hole_debug.png
*_visual_comparison.png
*.metrics.json
qa_results.csv

# macOS Finder metadata
.DS_Store
