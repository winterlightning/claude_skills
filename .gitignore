# Staging dirs left behind by an interrupted build.py run
.icon-build-*/
__pycache__/
*.pyc

# Local working files and reports at the repository root.
/work/
/reports/

# Runtime state: review database and backups, uploads, stroke edits, agent jobs,
# API keys. It lives in one folder and is never committed.
/icon_set/state/
/icon_set/progression.sqlite3
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Regenerated per-icon validation evidence inside the build root. Everything
# else under published/ is committed.
/published/qa/
/published/build-progress.json
*_distance_debug.png
*_hole_debug.png
*_visual_comparison.png
*.metrics.json
qa_results.csv

# Execution logs, process ids and lock files.
/icon_set/work/**/*.log
/icon_set/work/**/*.pid
/.published.lock

# Retired folders kept on disk only: old build outputs and agent batch copies.
/icon_set/.local/
/icon_set/dist/
/icon_set/assets/previews-png/
/icon_set/scripts/.codex-batch-runner/
/icons-json
/head
.venv/

# macOS Finder metadata
.DS_Store
TASKS.md
DESCRIPTION.md
