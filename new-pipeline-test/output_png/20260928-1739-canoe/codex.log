/bin/zsh -lc "rtk proxy python3 - <<'PY'
from PIL import Image
from pathlib import Path
src=Path('/Users/jakesdev/.codex/generated_images/01a0e798-5d4b-7640-9d63-4baa3493f50b/exec-af95b2ae-c2ab-4600-a9a7-91b4846b93ba.png')
dst=Path('new-pipeline-test/output_png/20260928-1739-canoe/canoe.png')
im=Image.open(src).convert('RGBA')
a=im.getchannel('A').point(lambda x: 255 if x>24 else 0)
bbox=a.getbbox()
print('source',im.size,'bbox',bbox)
crop=im.crop(bbox)
bg=Image.new('RGBA',crop.size,'white'); bg.alpha_composite(crop)
ink=bg.convert('RGB')
scale=854/max(ink.size)
ink=ink.resize((round(ink.width*scale),round(ink.height*scale)),Image.Resampling.LANCZOS)
canvas=Image.new('RGB',(1024,1024),'white')
canvas.paste(ink,((1024-ink.width)//2,(1024-ink.height)//2))
canvas.save(dst)
canvas.resize((48,48),Image.Resampling.LANCZOS).save('/tmp/canoe-final-48.png')
print('final',canvas.size,ink.size,dst)
