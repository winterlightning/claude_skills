{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Icon search metadata",
  "type": "object",
  "required": [
    "icon_id",
    "family",
    "name",
    "description",
    "tags",
    "aliases",
    "category",
    "keywords",
    "schema_version"
  ],
  "properties": {
    "icon_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "family": {
      "enum": [
        "sub",
        "solo",
        "container"
      ],
      "description": "The authored family. Bound one-to-one to profile by the profile contract: sub=SUB32, solo=SOLO48, container=CONTAINER64. A composition is 'container'."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "category": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "additionalProperties": true
}
